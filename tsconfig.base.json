{
  "compilerOptions": {
    "target": "ES2022",
    "rootDir": "src",
    "sourceMap": true,
    "inlineSources": true,
    "stripInternal": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
